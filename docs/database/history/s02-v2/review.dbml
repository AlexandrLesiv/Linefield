Project Linefield_S02_proposal_v2 {
  Note: '''
# Linefield S02 v2 — consolidated database and interfaces proposal

OWNER APPROVED on 2026-10-16, decision 181: concrete amendments, signatures, recovery transitions, provisional starting budgets and test plan. Approved against hosted Version 6; this publication changes approval notes only.
SELECTED POLICIES: DB1–DB22, decisions through 180; cloud retention deliberately deferred.
HISTORICAL APPROVAL: Version 3 table baseline and selected Version 5 counter amendment. The owner separately approved the v2 amendments in decision 181.
NOT IMPLEMENTED: no application, migrations, generated header or runtime tests. Documentation only, 2026-10-16.

Three namespaces below represent separate SQLite files; cross-file references are logical, not SQL foreign keys.
Drawing: authoritative artwork, 16-byte IDs, row-per-sample original geometry and transforms. NEW database incarnation and whole-stroke mutation revision. Private command_receipts REPLACE rename_receipts; outcomes commit atomically with drawing changes.
Catalog: local indexes and lifecycle authority. NEW source incarnation projection/fence, not duplicate artwork.
Jobs: durable exports and native destination grants. NEW source-incarnation binding for immutable snapshots.

Typed Rust commands remain authoritative. Host process main thread owns its coordinator; other clients own projections/previews only. Bounded background storage holds the authority guard through transaction completion.
macOS WAL + synchronous FULL, fullfsync OFF, checkpoint_fullfsync OFF. No equivalent browser durability claim.
No client journal, persistent Undo, automatic semantic merge, new daemon, custom command protocol or fourth database.

Exact review packet: docs/reviews/S02-consolidated-v2.md.
Schema dictionary/constraints: docs/database/schema-v2.md.
Typed signatures: docs/interfaces/native-v2.md.
Recovery/limits/tests: docs/architecture/recovery-v2.md, docs/architecture/limits-v2.md, quality/S02-v2-test-plan.md.
Portable exports construct fresh allowlisted databases with empty receipt tables; raw backup-and-delete is not privacy scrubbing.
Immutable source hashes and review evidence are recorded locally. This hosted page is a private review copy, not an approval gate.
'''
}

Table drawing.document [headercolor: #2563EB] {
  singleton INTEGER [pk, not null, note: 'CHECK(singleton = 1)']
  document_id BLOB [not null, unique, note: '16-byte UUIDv4']
  database_incarnation BLOB [not null, note: '16-byte instance UUID; changes on controlled replacement, not coordinator restart']
  display_name TEXT [not null]
  content_revision INTEGER [not null]
  metadata_revision INTEGER [not null]
  created_utc_us INTEGER [not null]
  content_edited_utc_us INTEGER [not null]
  color_space TEXT [not null, note: 'srgb only initially']
}
Table drawing.tools [headercolor: #2563EB] {
  tool_key INTEGER [pk, not null]
  tool_id BLOB [not null, unique, note: '16-byte stable UUID']
  name_key TEXT [not null, unique, note: 'Stable machine key, not localized display text']
}
Table drawing.strokes [headercolor: #2563EB] {
  stroke_key INTEGER [pk, not null]
  stroke_id BLOB [not null, unique, note: '16-byte UUIDv4']
  mutation_revision INTEGER [not null, note: 'Resulting content revision of last stroke mutation; fresh on Undo restoration']
  tool_key INTEGER [not null]
  paint_order INTEGER [not null, unique]
  base_width REAL [not null]
  red REAL [not null]
  green REAL [not null]
  blue REAL [not null]
  alpha REAL [not null]
  translation_x REAL [not null]
  translation_y REAL [not null]
  uniform_scale REAL [not null]
}
Table drawing.samples [headercolor: #2563EB] {
  stroke_key INTEGER [not null]
  sample_index INTEGER [not null]
  x REAL [not null]
  y REAL [not null]
  pressure REAL [note: 'NULL unavailable, otherwise 0..1']
  indexes {
    (stroke_key, sample_index) [pk]
  }
}
Table drawing.command_receipts [headercolor: #2563EB] {
  operation_id BLOB [pk, not null, note: '16-byte command UUID; private committed outcome only']
  client_session_id BLOB [not null, note: '16-byte authenticated-session binding; not itself a credential']
  client_sequence INTEGER [not null]
  owner_generation BLOB [not null, note: '16-byte generation under which command was admitted']
  database_incarnation BLOB [not null]
  command_kind TEXT [not null, note: 'add_stroke, move_stroke, scale_stroke, delete_stroke, undo, redo, rename']
  argument_fingerprint BLOB [not null, note: '32-byte private validated-argument digest, never exported or logged']
  base_content_revision INTEGER [not null]
  base_metadata_revision INTEGER [not null]
  result_content_revision INTEGER [not null]
  result_metadata_revision INTEGER [not null]
  committed_utc_us INTEGER [not null]
  indexes {
    (owner_generation, client_session_id, client_sequence) [unique]
    (committed_utc_us, operation_id)
  }
}
Ref: drawing.strokes.tool_key > drawing.tools.tool_key [delete: restrict, update: restrict, color: #2563EB]
Ref: drawing.samples.stroke_key > drawing.strokes.stroke_key [delete: cascade, update: restrict, color: #2563EB]

Table catalog.library [headercolor: #16816A] {
  singleton INTEGER [pk, not null, note: 'CHECK(singleton = 1)']
  library_id BLOB [not null, unique]
  catalog_incarnation BLOB [not null, note: 'Fresh 16-byte UUID after rebuild/replacement']
  catalog_generation INTEGER [not null]
  automatic_name_highwater INTEGER [not null]
  activity_highwater INTEGER [not null, note: 'Local monotonic gallery activity allocator; never use wall-clock time']
  sequence_recovery_state TEXT [not null]
}
Table catalog.tools [headercolor: #16816A] {
  tool_key INTEGER [pk, not null]
  tool_id BLOB [not null, unique]
  name_key TEXT [not null, unique]
}
Table catalog.drawings [headercolor: #16816A] {
  drawing_key INTEGER [pk, not null]
  document_id BLOB [not null, unique]
  database_incarnation BLOB [not null, note: 'Last observed drawing incarnation; repairable projection']
  managed_file_id BLOB [not null, unique, note: 'Opaque app-managed locator; not a display name or source path']
  display_name TEXT [not null]
  content_revision INTEGER [not null]
  metadata_revision INTEGER [not null]
  created_utc_us INTEGER [not null]
  content_edited_utc_us INTEGER [not null]
  added_utc_us INTEGER [not null]
  activity_order INTEGER [not null, note: 'Persistent local activity ordinal; descending order, timestamps remain independent']
  availability TEXT [not null]
  indexes {
    (activity_order, document_id)
  }
}
Table catalog.local_view [headercolor: #16816A] {
  drawing_key INTEGER [pk, not null]
  preference_revision INTEGER [not null]
  center_x REAL [not null]
  center_y REAL [not null]
  zoom REAL [not null]
  active_tool_key INTEGER [not null]
}
Table catalog.pen_preferences [headercolor: #16816A] {
  drawing_key INTEGER [not null]
  tool_key INTEGER [not null]
  preference_revision INTEGER [not null]
  width REAL [not null]
  red REAL [not null]
  green REAL [not null]
  blue REAL [not null]
  alpha REAL [not null]
  indexes {
    (drawing_key, tool_key) [pk]
  }
}
Table catalog.lifecycle [headercolor: #16816A] {
  operation_id BLOB [pk, not null]
  document_id BLOB [not null]
  managed_file_id BLOB [not null]
  operation_kind TEXT [not null]
  phase TEXT [not null]
  expected_database_incarnation BLOB [note: 'Required for existing-file operations; nullable before new-file staging']
  expected_content_revision INTEGER
  expected_metadata_revision INTEGER
  automatic_name_number INTEGER
  confirmed_utc_us INTEGER
  updated_utc_us INTEGER [not null]
  indexes {
    (document_id, operation_kind)
  }
}
Ref: catalog.drawings.drawing_key - catalog.local_view.drawing_key [delete: cascade, update: restrict, color: #16816A]
Ref: catalog.local_view.active_tool_key > catalog.tools.tool_key [delete: restrict, update: restrict, color: #16816A]
Ref: catalog.pen_preferences.drawing_key > catalog.drawings.drawing_key [delete: cascade, update: restrict, color: #16816A]
Ref: catalog.pen_preferences.tool_key > catalog.tools.tool_key [delete: restrict, update: restrict, color: #16816A]

Table jobs.snapshots [headercolor: #B86C16] {
  snapshot_id BLOB [pk, not null]
  managed_file_id BLOB [not null, unique]
  document_id BLOB [not null, note: 'Logical source identity only']
  source_database_incarnation BLOB [not null, note: 'Captured source instance; independent snapshot has its own incarnation']
  content_revision INTEGER [not null]
  metadata_revision INTEGER [not null]
  byte_length INTEGER [not null]
  digest_sha256 BLOB [not null]
  state TEXT [not null]
}
Table jobs.destinations [headercolor: #B86C16] {
  destination_id BLOB [pk, not null]
  access_kind TEXT [not null]
  access_reference BLOB [not null, note: 'Bounded host-native bookmark/grant; no generic command codec']
  target_identity BLOB [note: 'Bounded native identity, NULL if no target existed']
  destination_serialization_key BLOB [not null]
}
Table jobs.export_jobs [headercolor: #B86C16] {
  job_id BLOB [pk, not null]
  source_document_id BLOB [not null]
  snapshot_id BLOB
  destination_id BLOB
  format TEXT [not null]
  state TEXT [not null]
  admission_instance_id BLOB [not null]
  claim_instance_id BLOB
  claim_generation INTEGER [not null]
  accepted_utc_us INTEGER [not null]
  publication_phase TEXT [not null]
  approved_target_identity BLOB
  outcome_code TEXT
  indexes {
    (state, accepted_utc_us, job_id)
    (source_document_id, state)
  }
}
Ref: jobs.export_jobs.snapshot_id >? jobs.snapshots.snapshot_id [delete: restrict, update: restrict, color: #B86C16]
Ref: jobs.export_jobs.destination_id >? jobs.destinations.destination_id [delete: restrict, update: restrict, color: #B86C16]

TableGroup "Drawing document" [color: #2563EB] {
  drawing.document
  drawing.tools
  drawing.strokes
  drawing.samples
  drawing.command_receipts
}
TableGroup "Local library" [color: #16816A] {
  catalog.library
  catalog.drawings
  catalog.tools
  catalog.local_view
  catalog.pen_preferences
  catalog.lifecycle
}
TableGroup "Export processing" [color: #B86C16] {
  jobs.snapshots
  jobs.destinations
  jobs.export_jobs
}
