Project catalog_deletion_amendment_v4_1 {
  Note: 'PROPOSED deletion amendment v4.1; NOT IMPLEMENTED or schema-approved. Complete v3 catalog context plus three proposed removal tables; drawing/jobs unchanged. See proposal.md for SQL partial indexes, state constraints, exact-set transitions and privacy. No hosted/CLI validation claimed.'
}
Table library {
  singleton INTEGER [pk, not null, note: 'CHECK(singleton = 1)']
  library_id BLOB [not null, unique]
  catalog_incarnation BLOB [not null, note: 'Fresh 16-byte UUID after rebuild/replacement']
  catalog_generation INTEGER [not null]
  automatic_name_highwater INTEGER [not null]
  activity_highwater INTEGER [not null, note: 'Local monotonic gallery activity allocator; never use wall-clock time']
  sequence_recovery_state TEXT [not null]
}
Table tools {
  tool_key INTEGER [pk, not null]
  tool_id BLOB [not null, unique]
  name_key TEXT [not null, unique]
}
Table drawings {
  drawing_key INTEGER [pk, not null]
  document_id BLOB [not null, unique]
  database_incarnation BLOB [not null, note: 'Last observed drawing incarnation; repairable projection']
  managed_file_id BLOB [not null, unique, note: 'Opaque app-managed locator; not a display name or source path']
  display_name TEXT [not null]
  content_revision INTEGER [not null]
  metadata_revision INTEGER [not null]
  created_utc_us INTEGER [not null]
  content_edited_utc_us INTEGER [not null]
  added_utc_us INTEGER [not null]
  activity_order INTEGER [not null, note: 'Persistent local activity ordinal; descending order, timestamps remain independent']
  availability TEXT [not null]
  indexes {
    (activity_order, document_id)
  }
}
Table local_view {
  drawing_key INTEGER [pk, not null]
  preference_revision INTEGER [not null]
  center_region_x INTEGER [not null, note: 'Signed i64 saved viewport-center region; device-local preference']
  center_region_y INTEGER [not null, note: 'Signed i64 saved viewport-center region; positive Y down']
  center_local_x REAL [not null, note: 'Finite canonical local offset; CHECK(0 <= value AND value < 65536); +0']
  center_local_y REAL [not null, note: 'Finite canonical local offset; CHECK(0 <= value AND value < 65536); +0']
  zoom REAL [not null, note: 'CHECK(value BETWEEN 0.1 AND 8); 1 means 100 percent']
  active_tool_key INTEGER [not null]
}
Table pen_preferences {
  drawing_key INTEGER [not null]
  tool_key INTEGER [not null]
  preference_revision INTEGER [not null]
  width REAL [not null, note: 'Maximum untransformed pen width; CHECK(value BETWEEN 1 AND 512)']
  red REAL [not null]
  green REAL [not null]
  blue REAL [not null]
  alpha REAL [not null]
  indexes {
    (drawing_key, tool_key) [pk]
  }
}
Table lifecycle {
  operation_id BLOB [pk, not null]
  document_id BLOB [not null]
  managed_file_id BLOB [not null]
  operation_kind TEXT [not null]
  phase TEXT [not null]
  expected_database_incarnation BLOB [note: 'Required for existing-file operations; nullable before new-file staging']
  expected_content_revision INTEGER
  expected_metadata_revision INTEGER
  automatic_name_number INTEGER
  confirmed_utc_us INTEGER
  updated_utc_us INTEGER [not null]
  indexes {
    (document_id, operation_kind)
  }
}
Ref: drawings.drawing_key - local_view.drawing_key [delete: cascade, update: restrict]
Ref: local_view.active_tool_key > tools.tool_key [delete: restrict, update: restrict]
Ref: pen_preferences.drawing_key > drawings.drawing_key [delete: cascade, update: restrict]
Ref: pen_preferences.tool_key > tools.tool_key [delete: restrict, update: restrict]

Table removal_scopes {
  scope_id BLOB [pk, not null, note: 'UUID length16; runtime-created gallery visit, never a bearer capability']
  catalog_incarnation BLOB [not null, note: 'UUID length16; Rust matches current library incarnation']
  claim_generation INTEGER [not null, note: 'Nonnegative i64; checked increment on exclusive claim']
  scope_revision INTEGER [not null, note: 'Nonnegative i64; optimistic command precondition']
  state TEXT [not null, note: 'CHECK open or committed; transitions validated in Rust']
  Note: 'Current scope/fencing state, NOT a durable Create/Claim request receipt. One verified runtime grant holder. Lost acquisition results use live bounded request lookup or Unknown followed by verified retirement and fresh claim; never infer grant from row existence/generation. See proposal.md. No persisted credential or timeout takeover.'
}
Table removals {
  removal_id BLOB [pk, not null, note: 'Stage operation UUID length16']
  scope_id BLOB [not null]
  stage_fingerprint BLOB [not null, note: '32-byte versioned canonical semantic request digest; private']
  document_id BLOB [not null, note: 'UUID length16; logical drawing reference, no SQL FK']
  managed_file_id BLOB [not null, note: 'UUID length16; immutable managed target, no path']
  database_incarnation BLOB [not null, note: 'UUID length16; exact expected instance']
  content_revision INTEGER [not null, note: 'Nonnegative i64; exact protected revision']
  metadata_revision INTEGER [not null, note: 'Nonnegative i64; exact protected revision']
  state TEXT [not null, note: 'CHECK staged, restored, finalizing or cleaned; legal transitions Rust']
  undo_operation_id BLOB [unique, note: 'UUID length16; present iff restored']
  undo_fingerprint BLOB [note: '32 bytes; present iff restored together with undo_operation_id']
  departure_id BLOB [note: 'UUID length16; present iff finalizing or cleaned']
  indexes {
    (scope_id, state, removal_id)
    (departure_id, removal_id)
  }
  Note: 'SQL partial UNIQUE(document_id) WHERE state IN (staged,finalizing) is required but not expressible here. Stage preserves existing drawings row/name/activity position. Terminal receipts survive drawing deletion. SQL state-dependent null CHECKs and Rust transaction checks are specified in proposal.md.'
}
Table departures {
  departure_id BLOB [pk, not null, note: 'Committed departure operation UUID length16']
  scope_id BLOB [not null, unique, note: 'At most one committed departure per scope']
  argument_fingerprint BLOB [not null, note: '32 bytes; binds canonical exact removal set and destination']
  destination_document_id BLOB [not null, note: 'UUID length16; logical validated destination, no cross-file FK']
  destination_database_incarnation BLOB [not null, note: 'UUID length16']
  result_scope_revision INTEGER [not null, note: 'Positive i64; matches committed closed scope']
  removal_count INTEGER [not null, note: 'CHECK between 1 and 256; exact count/member equality checked in Rust transaction']
  indexes {
    (departure_id, scope_id) [unique]
  }
  Note: 'Immutable acceptance receipt; one or more removals. Insert with exact members, scope closure and lifecycle cleanup intents in one catalog transaction. Lost reply queries this outcome; absence is not permission to replay.'
}
Ref: removals.scope_id > removal_scopes.scope_id [delete: restrict, update: restrict]
Ref: departures.scope_id - removal_scopes.scope_id [delete: restrict, update: restrict]
Ref: removals.(departure_id, scope_id) > departures.(departure_id, scope_id) [delete: restrict, update: restrict]

