{
  "name": "linefield",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "action": "node scripts/action.ts",
    "actions:test": "node --test scripts/actions/*.test.ts",
    "probe:regional": "node scripts/probes/regional/run.ts",
    "probe:regional:test": "node --test scripts/probes/regional/*.test.ts",
    "check": "node scripts/check.ts",
    "typecheck": "node scripts/localization.ts && tsc --noEmit",
    "lint": "oxlint --deny-warnings scripts shared/theme shared/localization",
    "format": "oxfmt package.json tsconfig.json .oxlintrc.json .oxfmtrc.json pnpm-workspace.yaml scripts shared/theme shared/localization shared/diagrams shared/schema",
    "format:check": "oxfmt --check package.json tsconfig.json .oxlintrc.json .oxfmtrc.json pnpm-workspace.yaml scripts shared/theme shared/localization shared/diagrams shared/schema",
    "web:dev": "pnpm --filter @linefield/web dev",
    "web:build": "pnpm --filter @linefield/web build",
    "web:test": "pnpm --filter @linefield/web test",
    "locales:generate": "node scripts/localization.ts",
    "locales:check": "node scripts/localization.ts --check",
    "locales:test": "node --test scripts/localization/*.test.ts",
    "locales:native-check": "node scripts/localization/native-check.ts",
    "theme:check": "node scripts/theme-validation.ts",
    "theme:test": "node --test scripts/theme-validation.test.ts scripts/theme-resources/*.test.ts",
    "theme:generate": "node scripts/theme-resources.ts",
    "theme:resources:check": "node scripts/theme-resources.ts --check",
    "theme:native-check": "node scripts/theme-resources/native-check.ts",
    "diagrams:generate": "node scripts/diagrams/generate.ts",
    "diagrams:check": "node scripts/diagrams/generate.ts --check",
    "diagrams:test": "node --test scripts/diagrams/*.test.ts",
    "schema:generate": "node scripts/schema/generate.ts",
    "schema:check": "node scripts/schema/generate.ts --check",
    "schema:test": "node --test scripts/schema/*.test.ts scripts/probes/library-schema/constraints.test.ts",
    "tasks:generate": "node scripts/tasks/generate.ts",
    "tasks:check": "node scripts/tasks/generate.ts --check",
    "tasks:test": "node --test scripts/tasks/*.test.ts",
    "tasks:browser": "node scripts/tasks/preview-browser.ts",
    "tasks:preview": "node scripts/tasks/serve.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": "10.26.0"
  },
  "packageManager": "pnpm@10.26.0"
}
