// Proposed v4.1 amendment: approved v3 context below is preserved; new tables appended. No implementation approval.
Project Linefield_S02_deletion_v4_1 {
  Note: '''
# Linefield S02 deletion amendment v4.1
PROPOSED AMENDMENT — NOT IMPLEMENTED OR SCHEMA-APPROVED, 2026-10-19.
The original regional v3 schema was approved in decision209; its tables are preserved below.
Decision236 approves durable-library sequencing and recoverable removal lifecycle, not these new mechanisms.
17 tables, 146 columns, 11 same-file relationships. Three namespaces represent separate SQLite files.
New catalog tables: removal_scopes, removals and departures. Drawing/jobs tables unchanged.
Stage preserves target bytes and Undo. Only an exact-set durable departure after destination readiness ends Undo.
No timeout finalization, persistent document edit Undo, new database or cross-file SQL foreign key.
Proposed scope ownership, acquisition reconciliation, bounds and partial SQL constraints require owner review.
See docs/database/deletion-v4/proposal.md for dictionary, sequence, migration and17 planned cases.
DBML is review documentation, not executable migrations. Exact browser lock/flush and generated contracts remain gates.
Private schema notes only; no drawing content, credentials or grants.
'''
}

Table drawing.document [headercolor: #2563EB] {
  singleton INTEGER [pk, not null, note: 'CHECK(singleton = 1)']
  document_id BLOB [not null, unique, note: '16-byte UUIDv4']
  database_incarnation BLOB [not null, note: '16-byte instance UUID; changes on controlled replacement, not coordinator restart']
  display_name TEXT [not null]
  content_revision INTEGER [not null]
  metadata_revision INTEGER [not null]
  created_utc_us INTEGER [not null]
  content_edited_utc_us INTEGER [not null]
  color_space TEXT [not null, note: 'srgb only initially']
}
Table drawing.tools [headercolor: #2563EB] {
  tool_key INTEGER [pk, not null]
  tool_id BLOB [not null, unique, note: '16-byte stable UUID']
  name_key TEXT [not null, unique, note: 'Stable machine key, not localized display text']
}
Table drawing.strokes [headercolor: #2563EB] {
  stroke_key INTEGER [pk, not null]
  stroke_id BLOB [not null, unique, note: '16-byte UUIDv4']
  mutation_revision INTEGER [not null, note: 'Resulting content revision of last stroke mutation; fresh on Undo restoration']
  tool_key INTEGER [not null]
  paint_order INTEGER [not null, unique]
  base_width REAL [not null, note: 'Logical units before transform; CHECK(value BETWEEN 1 AND 512)']
  red REAL [not null]
  green REAL [not null]
  blue REAL [not null]
  alpha REAL [not null]
  placement_region_x INTEGER [not null, note: 'Signed i64 region address; Rust checked arithmetic']
  placement_region_y INTEGER [not null, note: 'Signed i64 region address; positive Y down']
  placement_local_x REAL [not null, note: 'Finite canonical local offset; CHECK(0 <= value AND value < 65536); +0']
  placement_local_y REAL [not null, note: 'Finite canonical local offset; CHECK(0 <= value AND value < 65536); +0']
  uniform_scale REAL [not null, note: 'CHECK(value BETWEEN 0.015625 AND 64); original points and base width preserved']
}
Table drawing.samples [headercolor: #2563EB] {
  stroke_key INTEGER [not null]
  sample_index INTEGER [not null, note: 'Nonnegative contiguous from 0; sample 0 is derived immutable source anchor']
  region_x INTEGER [not null, note: 'Signed i64 original region address']
  region_y INTEGER [not null, note: 'Signed i64 original region address; positive Y down']
  local_x REAL [not null, note: 'Finite canonical local offset; CHECK(0 <= value AND value < 65536); +0']
  local_y REAL [not null, note: 'Finite canonical local offset; CHECK(0 <= value AND value < 65536); +0']
  pressure REAL [note: 'NULL unavailable, otherwise 0..1']
  indexes {
    (stroke_key, sample_index) [pk]
  }
}
Table drawing.command_receipts [headercolor: #2563EB] {
  operation_id BLOB [pk, not null, note: '16-byte command UUID; private committed outcome only']
  client_session_id BLOB [not null, note: '16-byte authenticated-session binding; not itself a credential']
  client_sequence INTEGER [not null]
  owner_generation BLOB [not null, note: '16-byte generation under which command was admitted']
  database_incarnation BLOB [not null]
  command_kind TEXT [not null, note: 'add_stroke, move_stroke, scale_stroke, delete_stroke, undo, redo, rename']
  argument_fingerprint BLOB [not null, note: '32-byte private validated-argument digest, never exported or logged']
  base_content_revision INTEGER [not null]
  base_metadata_revision INTEGER [not null]
  result_content_revision INTEGER [not null]
  result_metadata_revision INTEGER [not null]
  committed_utc_us INTEGER [not null]
  indexes {
    (owner_generation, client_session_id, client_sequence) [unique]
    (committed_utc_us, operation_id)
  }
}
Ref: drawing.strokes.tool_key > drawing.tools.tool_key [delete: restrict, update: restrict, color: #2563EB]
Ref: drawing.samples.stroke_key > drawing.strokes.stroke_key [delete: cascade, update: restrict, color: #2563EB]

Table catalog.library [headercolor: #16816A] {
  singleton INTEGER [pk, not null, note: 'CHECK(singleton = 1)']
  library_id BLOB [not null, unique]
  catalog_incarnation BLOB [not null, note: 'Fresh 16-byte UUID after rebuild/replacement']
  catalog_generation INTEGER [not null]
  automatic_name_highwater INTEGER [not null]
  activity_highwater INTEGER [not null, note: 'Local monotonic gallery activity allocator; never use wall-clock time']
  sequence_recovery_state TEXT [not null]
}
Table catalog.tools [headercolor: #16816A] {
  tool_key INTEGER [pk, not null]
  tool_id BLOB [not null, unique]
  name_key TEXT [not null, unique]
}
Table catalog.drawings [headercolor: #16816A] {
  drawing_key INTEGER [pk, not null]
  document_id BLOB [not null, unique]
  database_incarnation BLOB [not null, note: 'Last observed drawing incarnation; repairable projection']
  managed_file_id BLOB [not null, unique, note: 'Opaque app-managed locator; not a display name or source path']
  display_name TEXT [not null]
  content_revision INTEGER [not null]
  metadata_revision INTEGER [not null]
  created_utc_us INTEGER [not null]
  content_edited_utc_us INTEGER [not null]
  added_utc_us INTEGER [not null]
  activity_order INTEGER [not null, note: 'Persistent local activity ordinal; descending order, timestamps remain independent']
  availability TEXT [not null]
  indexes {
    (activity_order, document_id)
  }
}
Table catalog.local_view [headercolor: #16816A] {
  drawing_key INTEGER [pk, not null]
  preference_revision INTEGER [not null]
  center_region_x INTEGER [not null, note: 'Signed i64 saved viewport-center region; device-local preference']
  center_region_y INTEGER [not null, note: 'Signed i64 saved viewport-center region; positive Y down']
  center_local_x REAL [not null, note: 'Finite canonical local offset; CHECK(0 <= value AND value < 65536); +0']
  center_local_y REAL [not null, note: 'Finite canonical local offset; CHECK(0 <= value AND value < 65536); +0']
  zoom REAL [not null, note: 'CHECK(value BETWEEN 0.1 AND 8); 1 means 100 percent']
  active_tool_key INTEGER [not null]
}
Table catalog.pen_preferences [headercolor: #16816A] {
  drawing_key INTEGER [not null]
  tool_key INTEGER [not null]
  preference_revision INTEGER [not null]
  width REAL [not null, note: 'Maximum untransformed pen width; CHECK(value BETWEEN 1 AND 512)']
  red REAL [not null]
  green REAL [not null]
  blue REAL [not null]
  alpha REAL [not null]
  indexes {
    (drawing_key, tool_key) [pk]
  }
}
Table catalog.lifecycle [headercolor: #16816A] {
  operation_id BLOB [pk, not null]
  document_id BLOB [not null]
  managed_file_id BLOB [not null]
  operation_kind TEXT [not null]
  phase TEXT [not null]
  expected_database_incarnation BLOB [note: 'Required for existing-file operations; nullable before new-file staging']
  expected_content_revision INTEGER
  expected_metadata_revision INTEGER
  automatic_name_number INTEGER
  confirmed_utc_us INTEGER
  updated_utc_us INTEGER [not null]
  indexes {
    (document_id, operation_kind)
  }
}
Ref: catalog.drawings.drawing_key - catalog.local_view.drawing_key [delete: cascade, update: restrict, color: #16816A]
Ref: catalog.local_view.active_tool_key > catalog.tools.tool_key [delete: restrict, update: restrict, color: #16816A]
Ref: catalog.pen_preferences.drawing_key > catalog.drawings.drawing_key [delete: cascade, update: restrict, color: #16816A]
Ref: catalog.pen_preferences.tool_key > catalog.tools.tool_key [delete: restrict, update: restrict, color: #16816A]

Table jobs.snapshots [headercolor: #B86C16] {
  snapshot_id BLOB [pk, not null]
  managed_file_id BLOB [not null, unique]
  document_id BLOB [not null, note: 'Logical source identity only']
  source_database_incarnation BLOB [not null, note: 'Captured source instance; independent snapshot has its own incarnation']
  content_revision INTEGER [not null]
  metadata_revision INTEGER [not null]
  byte_length INTEGER [not null]
  digest_sha256 BLOB [not null]
  state TEXT [not null]
}
Table jobs.destinations [headercolor: #B86C16] {
  destination_id BLOB [pk, not null]
  access_kind TEXT [not null]
  access_reference BLOB [not null, note: 'Bounded host-native bookmark/grant; no generic command codec']
  target_identity BLOB [note: 'Bounded native identity, NULL if no target existed']
  destination_serialization_key BLOB [not null]
}
Table jobs.export_jobs [headercolor: #B86C16] {
  job_id BLOB [pk, not null]
  source_document_id BLOB [not null]
  snapshot_id BLOB
  destination_id BLOB
  format TEXT [not null]
  state TEXT [not null]
  admission_instance_id BLOB [not null]
  claim_instance_id BLOB
  claim_generation INTEGER [not null]
  accepted_utc_us INTEGER [not null]
  publication_phase TEXT [not null]
  approved_target_identity BLOB
  outcome_code TEXT
  indexes {
    (state, accepted_utc_us, job_id)
    (source_document_id, state)
  }
}
Ref: jobs.export_jobs.snapshot_id >? jobs.snapshots.snapshot_id [delete: restrict, update: restrict, color: #B86C16]
Ref: jobs.export_jobs.destination_id >? jobs.destinations.destination_id [delete: restrict, update: restrict, color: #B86C16]

TableGroup "Drawing document" [color: #2563EB] {
  drawing.document
  drawing.tools
  drawing.strokes
  drawing.samples
  drawing.command_receipts
}
TableGroup "Local library" [color: #16816A] {
  catalog.library
  catalog.drawings
  catalog.tools
  catalog.local_view
  catalog.pen_preferences
  catalog.lifecycle
}
TableGroup "Export processing" [color: #B86C16] {
  jobs.snapshots
  jobs.destinations
  jobs.export_jobs
}

Table catalog.removal_scopes {
  scope_id BLOB [pk, not null, note: 'UUID length16; runtime-created gallery visit, never a bearer capability']
  catalog_incarnation BLOB [not null, note: 'UUID length16; Rust matches current library incarnation']
  claim_generation INTEGER [not null, note: 'Nonnegative i64; checked increment on exclusive claim']
  scope_revision INTEGER [not null, note: 'Nonnegative i64; optimistic command precondition']
  state TEXT [not null, note: 'CHECK open or committed; transitions validated in Rust']
  Note: 'Current scope/fencing state, NOT a durable Create/Claim request receipt. One verified runtime grant holder. Lost acquisition results use live bounded request lookup or Unknown followed by verified retirement and fresh claim; never infer grant from row existence/generation. See proposal.md. No persisted credential or timeout takeover.'
}
Table catalog.removals {
  removal_id BLOB [pk, not null, note: 'Stage operation UUID length16']
  scope_id BLOB [not null]
  stage_fingerprint BLOB [not null, note: '32-byte versioned canonical semantic request digest; private']
  document_id BLOB [not null, note: 'UUID length16; logical drawing reference, no SQL FK']
  managed_file_id BLOB [not null, note: 'UUID length16; immutable managed target, no path']
  database_incarnation BLOB [not null, note: 'UUID length16; exact expected instance']
  content_revision INTEGER [not null, note: 'Nonnegative i64; exact protected revision']
  metadata_revision INTEGER [not null, note: 'Nonnegative i64; exact protected revision']
  state TEXT [not null, note: 'CHECK staged, restored, finalizing or cleaned; legal transitions Rust']
  undo_operation_id BLOB [unique, note: 'UUID length16; present iff restored']
  undo_fingerprint BLOB [note: '32 bytes; present iff restored together with undo_operation_id']
  departure_id BLOB [note: 'UUID length16; present iff finalizing or cleaned']
  indexes {
    (scope_id, state, removal_id)
    (departure_id, removal_id)
  }
  Note: 'SQL partial UNIQUE(document_id) WHERE state IN (staged,finalizing) is required but not expressible here. Stage preserves existing drawings row/name/activity position. Terminal receipts survive drawing deletion. SQL state-dependent null CHECKs and Rust transaction checks are specified in proposal.md.'
}
Table catalog.departures {
  departure_id BLOB [pk, not null, note: 'Committed departure operation UUID length16']
  scope_id BLOB [not null, unique, note: 'At most one committed departure per scope']
  argument_fingerprint BLOB [not null, note: '32 bytes; binds canonical exact removal set and destination']
  destination_document_id BLOB [not null, note: 'UUID length16; logical validated destination, no cross-file FK']
  destination_database_incarnation BLOB [not null, note: 'UUID length16']
  result_scope_revision INTEGER [not null, note: 'Positive i64; matches committed closed scope']
  removal_count INTEGER [not null, note: 'CHECK between 1 and 256; exact count/member equality checked in Rust transaction']
  indexes {
    (departure_id, scope_id) [unique]
  }
  Note: 'Immutable acceptance receipt; one or more catalog.removals. Insert with exact members, scope closure and lifecycle cleanup intents in one catalog transaction. Lost reply queries this outcome; absence is not permission to replay.'
}
Ref: catalog.removals.scope_id > catalog.removal_scopes.scope_id [delete: restrict, update: restrict]
Ref: catalog.departures.scope_id - catalog.removal_scopes.scope_id [delete: restrict, update: restrict]
Ref: catalog.removals.(departure_id, scope_id) > catalog.departures.(departure_id, scope_id) [delete: restrict, update: restrict]

