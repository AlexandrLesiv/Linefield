{
  "name": "@linefield/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/localization.ts && vite --host 127.0.0.1 --port 65142 --strictPort",
    "build": "node ../../scripts/localization.ts && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 65142 --strictPort",
    "typecheck": "node ../../scripts/localization.ts && tsc --noEmit",
    "test": "node ../../scripts/localization.ts && playwright test",
    "lint": "oxlint --deny-warnings src tests",
    "format:check": "oxfmt --check src tests *.ts *.json index.html"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/vite-plugin": "5.2.6",
    "vite": "8.3.4"
  }
}
