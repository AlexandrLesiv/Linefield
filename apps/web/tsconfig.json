{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "#memory-bindings": ["../../.build-cache/web-memory/production/linefield_web_memory.d.ts"],
      "#preparation-bindings": [
        "../../.build-cache/web-memory/production/linefield_web_preparation.d.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
